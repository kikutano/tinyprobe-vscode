{
  "name": "tinyprobe-vscode",
  "displayName": "tinyprobe",
  "description": "Explore endpoints and run tinyprobe API workflows from VS Code: validation as you save, one-click calls, results in the Test Explorer.",
  "version": "0.7.0",
  "publisher": "kikutano",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1917",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kikutano/tinyprobe-vscode"
  },
  "bugs": {
    "url": "https://github.com/kikutano/tinyprobe-vscode/issues"
  },
  "homepage": "https://github.com/kikutano/tinyprobe-vscode#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "api",
    "api testing",
    "http",
    "rest",
    "yaml",
    "tinyprobe"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:yaml",
    "workspaceContains:**/*.yaml",
    "workspaceContains:**/*.yml"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "tinyprobe.mcp",
        "label": "tinyprobe"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tinyprobe",
          "title": "tinyprobe",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "tinyprobe": [
        {
          "id": "tinyprobe.environment",
          "name": "Environment"
        },
        {
          "id": "tinyprobe.history",
          "name": "History"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tinyprobe.environment",
        "when": "!tinyprobe.hasEnvironment",
        "contents": "No environment file is selected. Runs and calls get their variables from it with -e.\n[Select Environment](command:tinyprobe.selectEnvironment)\nEnvironment files are named env*.yaml or environment.yaml."
      },
      {
        "view": "tinyprobe.environment",
        "when": "tinyprobe.hasEnvironment",
        "contents": "This environment has no variables yet.\n[Add Variable](command:tinyprobe.environment.add)"
      },
      {
        "view": "tinyprobe.history",
        "contents": "The calls you make with Call on an endpoint appear here, with their responses, to see again or send again."
      }
    ],
    "commands": [
      {
        "command": "tinyprobe.runToHere",
        "title": "Run to Here",
        "category": "tinyprobe"
      },
      {
        "command": "tinyprobe.runWorkflow",
        "title": "Run Workflow",
        "category": "tinyprobe",
        "icon": "$(play)"
      },
      {
        "command": "tinyprobe.callEndpoint",
        "title": "Call Endpoint",
        "category": "tinyprobe"
      },
      {
        "command": "tinyprobe.generateWithAi",
        "title": "Generate Tests with AI",
        "category": "tinyprobe"
      },
      {
        "command": "tinyprobe.migrateWithAi",
        "title": "Migrate with AI",
        "category": "tinyprobe"
      },
      {
        "command": "tinyprobe.selectEnvironment",
        "title": "Select Environment",
        "category": "tinyprobe",
        "icon": "$(server-environment)"
      },
      {
        "command": "tinyprobe.showRun",
        "title": "Show Last Run",
        "category": "tinyprobe"
      },
      {
        "command": "tinyprobe.validate",
        "title": "Validate File",
        "category": "tinyprobe"
      },
      {
        "command": "tinyprobe.history.show",
        "title": "Show Response",
        "category": "tinyprobe"
      },
      {
        "command": "tinyprobe.history.sendAgain",
        "title": "Send Again",
        "category": "tinyprobe",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "tinyprobe.history.openEndpoint",
        "title": "Open Endpoint",
        "category": "tinyprobe",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tinyprobe.history.remove",
        "title": "Remove from History",
        "category": "tinyprobe"
      },
      {
        "command": "tinyprobe.history.clear",
        "title": "Clear History",
        "category": "tinyprobe",
        "icon": "$(clear-all)"
      },
      {
        "command": "tinyprobe.environment.open",
        "title": "Open Environment File",
        "category": "tinyprobe",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tinyprobe.environment.edit",
        "title": "Edit Value",
        "category": "tinyprobe",
        "icon": "$(edit)"
      },
      {
        "command": "tinyprobe.environment.add",
        "title": "Add Variable",
        "category": "tinyprobe",
        "icon": "$(add)"
      },
      {
        "command": "tinyprobe.environment.remove",
        "title": "Delete Variable",
        "category": "tinyprobe"
      },
      {
        "command": "tinyprobe.environment.copy",
        "title": "Copy Value",
        "category": "tinyprobe"
      },
      {
        "command": "tinyprobe.environment.showValues",
        "title": "Show Secret Values",
        "category": "tinyprobe",
        "icon": "$(eye)"
      },
      {
        "command": "tinyprobe.environment.hideValues",
        "title": "Hide Secret Values",
        "category": "tinyprobe",
        "icon": "$(eye-closed)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tinyprobe.runWorkflow",
          "when": "editorLangId == yaml"
        },
        {
          "command": "tinyprobe.callEndpoint",
          "when": "editorLangId == yaml"
        },
        {
          "command": "tinyprobe.validate",
          "when": "editorLangId == yaml"
        },
        {
          "command": "tinyprobe.runToHere",
          "when": "false"
        },
        {
          "command": "tinyprobe.history.show",
          "when": "false"
        },
        {
          "command": "tinyprobe.history.sendAgain",
          "when": "false"
        },
        {
          "command": "tinyprobe.history.openEndpoint",
          "when": "false"
        },
        {
          "command": "tinyprobe.history.remove",
          "when": "false"
        },
        {
          "command": "tinyprobe.environment.open",
          "when": "false"
        },
        {
          "command": "tinyprobe.environment.edit",
          "when": "false"
        },
        {
          "command": "tinyprobe.environment.remove",
          "when": "false"
        },
        {
          "command": "tinyprobe.environment.copy",
          "when": "false"
        },
        {
          "command": "tinyprobe.environment.showValues",
          "when": "false"
        },
        {
          "command": "tinyprobe.environment.hideValues",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "tinyprobe.migrateWithAi",
          "when": "resourceFilename =~ /(postman_collection|postman_environment|openapi|swagger|insomnia|^bruno\\.json$|\\.har$)/i",
          "group": "tinyprobe"
        }
      ],
      "editor/title/run": [
        {
          "command": "tinyprobe.runWorkflow",
          "when": "resourceLangId == yaml && tinyprobe.isWorkflow",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "tinyprobe.environment.add",
          "when": "view == tinyprobe.environment",
          "group": "navigation@1"
        },
        {
          "command": "tinyprobe.selectEnvironment",
          "when": "view == tinyprobe.environment",
          "group": "navigation@2"
        },
        {
          "command": "tinyprobe.environment.open",
          "when": "view == tinyprobe.environment && tinyprobe.hasEnvironment",
          "group": "navigation@3"
        },
        {
          "command": "tinyprobe.environment.showValues",
          "when": "view == tinyprobe.environment && !tinyprobe.showSecrets",
          "group": "navigation@4"
        },
        {
          "command": "tinyprobe.environment.hideValues",
          "when": "view == tinyprobe.environment && tinyprobe.showSecrets",
          "group": "navigation@4"
        },
        {
          "command": "tinyprobe.history.clear",
          "when": "view == tinyprobe.history",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tinyprobe.environment.edit",
          "when": "view == tinyprobe.environment && viewItem =~ /^tinyprobe\\.environment(Variable|Block)$/",
          "group": "inline"
        },
        {
          "command": "tinyprobe.environment.edit",
          "when": "view == tinyprobe.environment && viewItem =~ /^tinyprobe\\.environment(Variable|Block)$/",
          "group": "1_edit@1"
        },
        {
          "command": "tinyprobe.environment.copy",
          "when": "view == tinyprobe.environment && viewItem =~ /^tinyprobe\\.environment(Variable|Block)$/",
          "group": "1_edit@2"
        },
        {
          "command": "tinyprobe.environment.remove",
          "when": "view == tinyprobe.environment && viewItem =~ /^tinyprobe\\.environment(Variable|Block)$/",
          "group": "2_delete"
        },
        {
          "command": "tinyprobe.history.sendAgain",
          "when": "view == tinyprobe.history && viewItem == tinyprobe.historyEntry",
          "group": "inline"
        },
        {
          "command": "tinyprobe.history.sendAgain",
          "when": "view == tinyprobe.history && viewItem == tinyprobe.historyEntry",
          "group": "1_call@1"
        },
        {
          "command": "tinyprobe.history.show",
          "when": "view == tinyprobe.history && viewItem == tinyprobe.historyEntry",
          "group": "1_call@2"
        },
        {
          "command": "tinyprobe.history.openEndpoint",
          "when": "view == tinyprobe.history && viewItem == tinyprobe.historyEntry",
          "group": "1_call@3"
        },
        {
          "command": "tinyprobe.history.remove",
          "when": "view == tinyprobe.history && viewItem == tinyprobe.historyEntry",
          "group": "2_remove"
        }
      ]
    },
    "configuration": {
      "title": "tinyprobe",
      "properties": {
        "tinyprobe.path": {
          "type": "string",
          "default": "tinyprobe",
          "markdownDescription": "Path of the `tinyprobe` binary. The default finds it on the `PATH`. Install it with the [one-line installer](https://github.com/kikutano/tinyprobe#install)."
        },
        "tinyprobe.validateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Validate tinyprobe files when they are opened and saved, and show the problems in the editor."
        },
        "tinyprobe.variables": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Variables passed with `--var` to every run and call, over the environment file. Values are typed like YAML: `42` is a number, `\"42\"` a string."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "package": "npx --yes @vscode/vsce package"
  }
}
